# MemoBrain — Production Environment Variables
# Copy this file to .env and fill in every value before running ./start.sh

# ── Database (managed by the postgres container) ──────────────────────────────
DB_NAME=memobrain
DB_USER=memobrain
# Strong password — stick to A-Za-z0-9_- to avoid shell quoting issues
DB_PASSWORD=replace_with_strong_password

# ── Backend secrets ───────────────────────────────────────────────────────────
# Generate both with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_hex
ENCRYPTION_KEY=replace_with_64_char_hex

# ── CORS ──────────────────────────────────────────────────────────────────────
# The public URL browsers use to reach the app (no trailing slash)
CORS_ORIGIN=http://localhost:8091

# ── Port ──────────────────────────────────────────────────────────────────────
APP_PORT=8091
